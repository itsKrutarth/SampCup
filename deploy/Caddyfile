# Caddy gets and renews the HTTPS certificates by itself.
{$SITE_DOMAIN} {
	# Compress everything except the live-update stream, which must flush at once.
	@compress not path /api/public/stream
	encode @compress zstd gzip
	reverse_proxy app:8000 {
		flush_interval -1
	}
	header Strict-Transport-Security "max-age=31536000"
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
