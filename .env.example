# Copy to .env for local development. .env is git-ignored: never commit it.
# These values are for the local Docker database only, not for production.
APP_ENV=development
POSTGRES_DB=sampcup
POSTGRES_USER=sampcup
POSTGRES_PASSWORD=local-dev-only
DATABASE_URL=postgresql+psycopg://sampcup:local-dev-only@db:5432/sampcup
API_PORT=8000
WEB_PORT=5173
