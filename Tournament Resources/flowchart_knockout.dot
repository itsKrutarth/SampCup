// SAMP Cup knockout flow (40-team times and courts from sampcup_40team_knockout_schedule.csv).
// Render: dot -Tpng -Gdpi=150 flowchart_knockout.dot -o flowchart_knockout.png
digraph knockout {
  graph [rankdir=TB, fontname="Helvetica", fontsize=22, labelloc=t, nodesep=0.3, ranksep=0.5, pad=0.4, newrank=true,
         label=<<b>SAMP Cup: Knockout (top 4 of each group)</b><br/><font point-size="14">16 teams, single elimination, best-of-3 Final. Teams from the same group cannot meet before the semifinals.<br/>No team plays more than 2 games in a row: rest slots at 5:04 and 5:38.</font>>];
  node  [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled", color="#4A4A4A", margin="0.12,0.06", fillcolor="#F6D77A"];
  edge  [fontname="Helvetica", fontsize=11, color="#4A4A4A"];

  // time axis with courts in use
  node [shape=plaintext, style="", fontsize=13, fontcolor="#555555", margin=0];
  tG [label=<10:00 AM - 3:23 PM<br/><font point-size="11">9 courts</font>>];
  tS [label="3:30 PM"];
  t1 [label=<4:30 PM<br/><font point-size="11">8 courts</font>>];
  t2 [label=<4:47 PM<br/><font point-size="11">4 courts</font>>];
  t3 [label=<5:04 PM<br/><font point-size="11">rest</font>>];
  t4 [label=<5:21 PM<br/><font point-size="11">2 courts</font>>];
  t5 [label=<5:38 PM<br/><font point-size="11">rest</font>>];
  t6 [label=<5:55 - 6:37 PM<br/><font point-size="11">1 court</font>>];
  t7 [label="6:37 PM"];
  tG -> tS -> t1 -> t2 -> t3 -> t4 -> t5 -> t6 -> t7 [style=invis];

  node [shape=box, style="rounded,filled", fontcolor="#1F1F1F", fontsize=12, margin="0.12,0.06"];

  groups [label=<<b>Group play: 4 random groups, at least 8 games each</b><br/>Group standings decide 1st - 4th in each group>, fillcolor="#EAF2FB", width=8];
  sabha  [label=<<b>3:30 - 4:30 PM  Sabha, group photo, awards</b>  (no games)<br/>standings and Round of 16 posted>, fillcolor="#EFE4FA", color="#8E6BB8", penwidth=2, width=8];

  r1 [label=<<b>R16-1</b><br/>A 1st v B 4th>];
  r2 [label=<<b>R16-2</b><br/>C 2nd v D 3rd>];
  r3 [label=<<b>R16-3</b><br/>D 1st v C 4th>];
  r4 [label=<<b>R16-4</b><br/>B 2nd v A 3rd>];
  r5 [label=<<b>R16-5</b><br/>C 1st v D 4th>];
  r6 [label=<<b>R16-6</b><br/>A 2nd v B 3rd>];
  r7 [label=<<b>R16-7</b><br/>B 1st v A 4th>];
  r8 [label=<<b>R16-8</b><br/>D 2nd v C 3rd>];
  q1 [label=<<b>QF-1</b>>]; q2 [label=<<b>QF-2</b>>]; q3 [label=<<b>QF-3</b>>]; q4 [label=<<b>QF-4</b>>];
  s1 [label=<<b>SF-1</b>>]; s2 [label=<<b>SF-2</b>>];
  f  [label=<<b>FINAL: best of 3</b>  (court 1)<br/>game 1 5:55, game 2 6:10, game 3 6:25 only at 1-1<br/>first team to win 2 games>, fillcolor="#C9A227", color="#7A5C00", penwidth=3, fontsize=15];
  champ [label=<<b>SAMP Cup champion</b><br/>Final over 6:22 (2-0) or 6:37 (2-1); awards and wrap-up until 7:00 PM>, fillcolor="#C9A227", color="#7A5C00", penwidth=2];

  groups -> sabha [style=invis];
  sabha -> {r1 r2 r3 r4 r5 r6 r7 r8} [style=invis];
  {r1 r2} -> q1; {r3 r4} -> q2; {r5 r6} -> q3; {r7 r8} -> q4;
  {q1 q2} -> s1; {q3 q4} -> s2;
  {s1 s2} -> f -> champ;

  {rank=same; tG; groups}
  {rank=same; tS; sabha}
  {rank=same; t1; r1; r2; r3; r4; r5; r6; r7; r8}
  {rank=same; t2; q1; q2; q3; q4}
  {rank=same; t4; s1; s2}
  {rank=same; t6; f}
  {rank=same; t7; champ}
}
