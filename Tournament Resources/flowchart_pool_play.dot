// SAMP Cup group play flow. Render: dot -Tpng -Gdpi=150 flowchart_pool_play.dot -o flowchart_pool_play.png
digraph pool_play {
  graph [rankdir=TB, fontname="Helvetica", fontsize=22, labelloc=t, nodesep=0.5, ranksep=0.45, pad=0.4,
         label=<<b>SAMP Cup: Group Play</b><br/><font point-size="14">40 teams: 4 groups of 10, 160 games, 10:00 AM to 3:23 PM, 9 courts</font>>];
  node  [fontname="Helvetica", fontsize=13, shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#4A4A4A", margin="0.2,0.1"];
  edge  [fontname="Helvetica", fontsize=12, color="#4A4A4A"];

  checkin  [label=<<b>9:00 AM  Breakfast, warm-up, check-in</b><br/>Random team-number draw (1..N)<br/>sets the 4 groups (40 teams: A = 1-10, B = 11-20, C = 21-30, D = 31-40)>, fillcolor="#EAF2FB"];
  aarti    [label=<<b>9:45 AM  Aarti and Deep pragatya</b>>, fillcolor="#FFF1DC"];
  pairs    [label=<<b>Group pairings</b><br/>Every team plays 8 games against its own group<br/>(group of 8: everyone once + one rematch)>, fillcolor="#EAF2FB"];
  sched    [label=<<b>Group-play timetable (scheduler)</b><br/>17-min slots = 12 min play + 5 min change-over<br/>At most 2 games in a row per team<br/>No wait longer than lunch (51 min) between games; first game by 10:51 AM<br/>Each team: one lunch = 3 empty slots (51 min) between 12:00 and 2:00<br/>Times, courts and lunch printed on each team slip>, fillcolor="#EAF2FB"];
  next     [label=<<b>Team's next group game</b><br/>(time and court from the slip)>];

  present  [shape=diamond, label="Both teams\npresent?", fillcolor="#FFFBE6"];
  forfeit  [label=<<b>Forfeit</b><br/>11-0 to the team present<br/>game time 12:00>, fillcolor="#FDECEC"];
  start    [label=<<b>Judge taps Start</b><br/>12-minute game clock runs>];
  reach11  [shape=diamond, label="A team reaches\n11 before the\nclock ends?", fillcolor="#FFFBE6"];
  won11    [label=<<b>Team at 11 wins</b><br/>game time = real time to the 11th point>, fillcolor="#E8F6EC"];
  tied     [shape=diamond, label="Clock ends:\nscore tied?", fillcolor="#FFFBE6"];
  lead     [label=<<b>Team ahead wins</b><br/>score stands, game time 12:00>, fillcolor="#E8F6EC"];
  sudden   [label=<<b>Sudden death</b><br/>next rally winner +1 point (8-8 becomes 9-8)<br/>game time 12:00>, fillcolor="#E8F6EC"];
  record   [label=<<b>Judge enters final score</b><br/>saved with timestamps; every change audited>];

  six      [shape=diamond, label="Team has played\nall 8 games?", fillcolor="#FFFBE6"];
  rest     [label=<<b>Rest or lunch</b><br/>until the next game on the slip>];
  alldone  [label=<<b>All group games finished</b><br/>2:49 - 3:23 PM depending on team count>, fillcolor="#EAF2FB"];
  rank     [label=<<b>Group standings (strict order, inside each group)</b><br/>1. Most wins<br/>2. Most points scored<br/>3. Lowest average game time (clock-ended games = 12:00)<br/>4. Fewest points allowed<br/>5. Head-to-head (only 2 teams still tied: more wins between them)<br/>6. Random draw (seeded, logged)<br/>The step that placed each team is shown>, fillcolor="#EAF2FB"];
  seeds    [label=<<b>3:30 - 4:30 PM Sabha</b><br/>Group standings and the Round of 16 posted<br/>Top 4 of each group go through (16 teams); the rest are done for the day>, fillcolor="#FFF1DC"];
  ko       [label=<<b>Knockout: Round of 16 at 4:30 PM to best-of-3 Final from 5:55 PM</b><br/>see flowchart_knockout.png>, fillcolor="#F6D77A"];

  checkin -> aarti -> pairs -> sched -> next -> present;
  present -> forfeit [label="  no"];
  present -> start   [label="  yes"];
  start -> reach11;
  reach11 -> won11 [label="  yes"];
  reach11 -> tied  [label="  no"];
  tied -> lead   [label="  no"];
  tied -> sudden [label="  yes"];
  {forfeit won11 lead sudden} -> record;
  record -> six;
  six -> rest [label="  no"];
  rest -> next [constraint=false, style=dashed];
  six -> alldone [label="  yes"];
  alldone -> rank -> seeds -> ko;

  {rank=same; forfeit; start}
  {rank=same; won11; tied}
  {rank=same; lead; sudden}
  {rank=same; rest; alldone}
}
